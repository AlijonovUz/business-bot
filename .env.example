# @BotFather dan olingan Telegram bot tokeni
BOT_TOKEN=

# Bot adminining Telegram ID raqami (masalan: 123456789)
ADMIN_ID=

# Bot adminining Telegram username'i (@ belgisisiz)
ADMIN_USER=

# Bot nomi (bildirishnomalar va xabarlarda ko'rinadi)
BOT_NAME=byBusinessBot

# Vaqt mintaqasi (Timezone)
TIMEZONE=Asia/Tashkent

# Xabarlar tarixini bazada shifrlash kaliti (AES-256-GCM)
# Bo'sh qoldirilsa, bot o'zi avtomatik xavfsiz kalit yaratib oladi
ENCRYPTION_KEY=

# Ma'lumotlar bazasi drayveri: sqlite, mysql yoki pgsql (standart: sqlite)
DB_DRIVER=sqlite

# SQLite ma'lumotlar bazasi fayli yo'li (DB_DRIVER=sqlite bo'lganda)
DB_SQLITE_PATH=storage/database.sqlite

# MySQL / PostgreSQL ulanish parametrlari (DB_DRIVER=mysql yoki pgsql bo'lganda)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=business_bot
# DB_USER=root
# DB_PASS=

